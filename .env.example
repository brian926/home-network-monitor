# Copy to .env and fill in. Never commit .env.
#
# NOTE: Docker Compose substitutes a BLANK value for a variable that is present
# but empty, not "unset". A blank line here is not the same as a missing line —
# blank values are passed through as empty strings.

# ---------------------------------------------------------------------------
# Your network
# ---------------------------------------------------------------------------

# Your router / default gateway.
GATEWAY_IP=

# Your LAN DNS resolver (Pi-hole, AdGuard, etc).
PIHOLE_HOST=

# Network interface on the host running this stack, e.g. eth0 / enp7s0 / ens18.
# Find it with: ip -br link
# Used by the NIC error and saturation panels.
NIC_DEVICE=

# Space-separated list of addresses for continuous ICMP probing.
# Each one isolates a different suspect, so order them outward from you:
#   your gateway, your DNS resolver, your modem (if it has an IP),
#   then two or three public resolvers as a control.
# Example: 192.168.0.1 192.168.0.15 1.1.1.1 8.8.8.8 1.0.0.1
SMOKEPING_TARGETS=

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# Hostname you will type to reach the stack. Used by Grafana, Prometheus and
# Pushgateway to build absolute links, so it must match what you actually use.
#
# Prefer a real DNS name over mDNS: add a Local DNS record in Pi-hole pointing
# this name at the host's IP. Every device using Pi-hole for DNS then resolves
# it, including Android, which handles mDNS (.local) poorly.
#
# Do NOT use a .local name here — that suffix is reserved for mDNS and some
# clients bypass DNS for it entirely. Use .home, .lan, or .home.arpa.
PROXY_HOSTNAME=

# Host port for the proxy. Change if something already owns 80 — a Kubernetes
# ingress controller on the same host is the usual culprit.
PROXY_PORT=80

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------

GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Cable modem — Motorola MB8611 (DOCSIS statistics)
# ---------------------------------------------------------------------------
# Set MB8611_ENABLED=false if you do not have this modem, or if your modem is
# not reachable at an IP address (some ISP-supplied and bridged units are not).
# When disabled, the exporter idles and the DOCSIS dashboard stays empty.
#
# WARNING: never poll faster than 60 seconds. Aggressive polling can wedge this
# modem's web server and take your internet down until it is power-cycled.

MB8611_ENABLED=false
MB8611_HOST=
MB8611_USER=admin
MB8611_PASS=
MB8611_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Pi-hole
# ---------------------------------------------------------------------------
# Use a scoped app password, not your admin password, so it can be revoked
# independently. Pi-hole v6: Settings → Web interface / API → app password.

PIHOLE_APP_PASSWORD=

# ---------------------------------------------------------------------------
# speedtest-tracker
# ---------------------------------------------------------------------------
# APP_KEY must be a fresh random value. Generate with:
#   echo "base64:$(openssl rand -base64 32)"
# APP_URL needs a scheme and port, or the web UI generates broken links.

SPEEDTEST_APP_KEY=
SPEEDTEST_APP_URL=http://localhost:8080
SPEEDTEST_SCHEDULE=6 */1 * * *
SPEEDTEST_TZ=UTC
# Created in the speedtest-tracker web UI after first login.
SPEEDTEST_API_TOKEN=

# ---------------------------------------------------------------------------
# Bufferbloat job
# ---------------------------------------------------------------------------
# Each run saturates your connection for roughly 45 seconds. Offset it from
# SPEEDTEST_SCHEDULE so the two never collide.

BUFFERBLOAT_CRON=36 * * * *
BUFFERBLOAT_TARGET=1.1.1.1
# The job runs on the host network, where bridge service names do not resolve.
PUSHGATEWAY_URL=http://localhost:9091
